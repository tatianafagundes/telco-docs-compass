# Copy to .env (Lovable manages the real .env of this project). Names only, never real values.
# Browser and server read the same public project settings; the browser ones need the VITE_ prefix.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# Server only. Never put these in browser code or in the repository.
# SUPABASE_SERVICE_ROLE_KEY=      writes after an explicit role check (src/integrations/supabase/client.server.ts)
# LOVABLE_CRON_SECRET=            bearer secret for the scheduled routes
# LOVABLE_CRON_SECRET_PREVIOUS=   optional: the old secret, still accepted while a rotation is under way
